# =========================================================================
# Variables de Entorno - Matacos Deportes
# Copiar este archivo como '.env' para desarrollo o producción
# =========================================================================

# --- BASE DE DATOS (PostgreSQL) ---
POSTGRES_USER=matacos_admin
POSTGRES_PASSWORD=matacos_secure_password_2026
POSTGRES_DB=matacos_db
DATABASE_URL=postgresql://matacos_admin:matacos_secure_password_2026@localhost:5432/matacos_db?schema=public

# --- AUTENTICACIÓN (Auth.js / NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=super_secret_jwt_key_matacos_2026_change_in_production

# --- PASARELA DE PAGO: MERCADO PAGO ---
# Obtener en https://www.mercadopago.com.ar/developers
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADOPAGO_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# --- FACTURACIÓN FISCAL: AFIP / ARCA ---
# CUIT del titular de Matacos Deportes
AFIP_CUIT=20000000001
# Modo producción (true) o modo homologación/testing (false)
AFIP_PRODUCTION=false
AFIP_CERT_PATH=./certificates/matacos_afip.crt
AFIP_KEY_PATH=./certificates/matacos_afip.key

# --- CONFIGURACIÓN DE LA TIENDA ---
NEXT_PUBLIC_STORE_NAME="Matacos Deportes"
NEXT_PUBLIC_STORE_ADDRESS="Saavedra 241, Formosa, Argentina"
NEXT_PUBLIC_WHATSAPP_NUMBER="5493704000000"
