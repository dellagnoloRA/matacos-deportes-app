// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CAJERO
  DESPACHO
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  QR_MERCADOPAGO
  MERCADOPAGO_ONLINE
}

enum SaleStatus {
  PENDIENTE_PAGO
  PENDIENTE_VERIFICACION
  COMPLETADA
  CANCELADA
}

enum ShippingStatus {
  PENDIENTE
  EN_PREPARACION
  LISTO_RETIRO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CashShiftStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO_EXTRAORDINARIO
  RETIRO_CAJA_FUERTE
  GASTO_MENOR
  AJUSTE_ARQUEO
}

enum Gender {
  HOMBRE
  MUJER
  NINO
  UNISEX
}

model User {
  id             String      @id @default(uuid())
  username       String?     @unique
  email          String      @unique
  name           String
  password       String
  role           Role?       @default(CAJERO) // Campo legacy para compatibilidad
  profileId      String?
  profile        Profile?    @relation(fields: [profileId], references: [id])
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sales          Sale[]
  salesAsSeller  Sale[]      @relation("SaleSeller")
  salesAsCashier Sale[]      @relation("SaleCashier")
  cashShifts     CashShift[]
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(uuid())
  name       String
  slug       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([categoryId, slug])
}

model Brand {
  id         String      @id @default(uuid())
  name       String      @unique
  slug       String      @unique
  products   Product[]
  sizeGuides SizeGuide[]
}

model Discipline {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  imageUrl String?
  products Product[]
}

model SizeGuide {
  id         String    @id @default(uuid())
  name       String
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  gender     String    @default("UNISEX") // HOMBRE, MUJER, UNISEX, NINOS
  type       String    @default("CALZADO") // CALZADO, PRENDA_SUPERIOR, PRENDA_INFERIOR, ACCESORIO
  unit       String    @default("cm") // cm o in
  fitNote    String?
  columns    Json
  rows       Json
  guideImage String?
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model ProductDraft {
  id        String   @id @default(uuid())
  name      String?
  step      Int      @default(1)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String          @id @default(uuid())
  name             String
  slug             String?         @unique
  description      String?
  shortDescription String?
  imageUrl         String?
  modelCode        String?
  disciplineId     String
  discipline       Discipline      @relation(fields: [disciplineId], references: [id])
  costPrice        Decimal?        @db.Decimal(12, 2)
  price            Decimal         @db.Decimal(12, 2)
  listPrice        Decimal?        @db.Decimal(12, 2)
  vatRate          Decimal         @default(21.0) @db.Decimal(5, 2)
  installments     Int             @default(6)
  gender           Gender          @default(UNISEX)
  tags             String[]        @default([])
  highlights       Json?
  specs            Json?
  weightGrams      Int?
  dimensionsCm     Json?
  status           String          @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED
  publishedAt      DateTime?
  metaTitle        String?
  metaDescription  String?

  // Campos de Descuento Promocional Web (RF-27 / RF-28)
  discountActive     Boolean       @default(false)
  discountPercentage Decimal?      @db.Decimal(5, 2)
  discountPrice      Decimal?      @db.Decimal(12, 2)
  discountStartDate  DateTime?
  discountEndDate    DateTime?

  active           Boolean         @default(true)
  ignoreAlerts     Boolean         @default(false)
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  subcategoryId    String?
  subcategory      Subcategory?    @relation(fields: [subcategoryId], references: [id])
  brandId          String
  brand            Brand           @relation(fields: [brandId], references: [id])
  sizeGuideId      String?
  sizeGuide        SizeGuide?      @relation(fields: [sizeGuideId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  favorites        Favorite[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([active, createdAt])
  @@index([active, discountActive])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  color     String? // Color asociado (ej: "Negro", "Marino/Rojo") o null para portada general
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String // Talle: 41, M, L, Único, etc.
  color          String // Color: Negro, Azul, etc.
  sku            String              @unique
  barcode        String?             @unique
  stockStore     Int                 @default(0) // Stock en Salón de Ventas / Mostrador
  stockWarehouse Int                 @default(0) // Stock en Depósito interno
  stockReserved  Int                 @default(0) // Stock comprometido / reservado
  minStoreStock  Int                 @default(1) // Umbral alerta de reposición interna (Depósito -> Salón)
  minStock       Int                 @default(2) // Umbral alerta de compra a proveedor
  price          Decimal?            @db.Decimal(12, 2) // Precio específico si varía
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([productId])
}

model InventoryMovement {
  id         String         @id @default(uuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  type       String // INGRESO_INICIAL, INGRESO_COMPRA, VENTA_MOSTRADOR, VENTA_WEB, DEVOLUCION_CLIENTE, ANULACION_VENTA, AJUSTE_INGRESO, AJUSTE_EGRESO, TRANSFERENCIA_INTERNA
  quantity   Int
  stockAfter Int // Stock total resultante (stockStore + stockWarehouse)
  location   String? // "STORE", "WAREHOUSE", "WAREHOUSE_TO_STORE"
  reason     String?
  createdAt  DateTime       @default(now())
}

model CashShift {
  id               String          @id @default(uuid())
  terminalId       String // "TERMINAL_1_SALON" o "TERMINAL_2_CAJA"
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  status           CashShiftStatus @default(ABIERTA)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  initialAmount    Decimal         @db.Decimal(12, 2)
  expectedCash     Decimal?        @db.Decimal(12, 2)
  expectedDebit    Decimal?        @db.Decimal(12, 2)
  expectedCredit   Decimal?        @db.Decimal(12, 2)
  expectedTransfer Decimal?        @db.Decimal(12, 2)
  expectedQr       Decimal?        @db.Decimal(12, 2)
  actualCash       Decimal?        @db.Decimal(12, 2)
  actualDebit      Decimal?        @db.Decimal(12, 2)
  actualCredit     Decimal?        @db.Decimal(12, 2)
  actualTransfer   Decimal?        @db.Decimal(12, 2)
  actualQr         Decimal?        @db.Decimal(12, 2)
  differenceCash   Decimal?        @db.Decimal(12, 2)
  notes            String?
  sales            Sale[]
  movements        CashMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CashMovement {
  id            String           @id @default(uuid())
  cashShiftId   String
  cashShift     CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  receiptNumber String?
  performedBy   String
  createdAt     DateTime         @default(now())
}

model Sale {
  id            String  @id @default(uuid())
  invoiceNumber String? @unique
  ticketCode    String?
  offlineId     String? @unique

  // Vínculo opcional con cuenta de cliente registrado
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Datos inmutables del comprador en este comprobante
  customerName  String?
  customerEmail String?
  customerPhone String?
  customerDni   String?

  // Datos logísticos de entrega en compras web
  shippingMethod       String?         // "RETIRO_LOCAL", "CADETERIA_FORMOSA", "CORREO_ARGENTINO_DOMICILIO", "CORREO_ARGENTINO_SUCURSAL"
  shippingStatus       ShippingStatus  @default(PENDIENTE)
  shippingTrackingCode String?         // Código de guía (ej. Correo Argentino)
  shippingCost         Decimal?        @default(0) @db.Decimal(12, 2)
  shippingAddress      String?         // Calle y número
  shippingCity         String?         // Localidad
  shippingPostalCode   String?
  shippingBranchCode   String?         // Código oficial de la sucursal de Correo Argentino
  shippingBranchName   String?         // Nombre descriptivo de la sucursal de entrega

  channel       String        @default("MOSTRADOR") // MOSTRADOR o WEB
  status        SaleStatus    @default(COMPLETADA)
  reservedUntil DateTime?     // Límite de reserva temporal de stock (TTL 15m en canal WEB)
  subtotalGross Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  sellerId      String?
  seller        User?         @relation("SaleSeller", fields: [sellerId], references: [id])
  cashierId     String?
  cashier       User?         @relation("SaleCashier", fields: [cashierId], references: [id])
  cashShiftId   String?
  cashShift     CashShift?    @relation(fields: [cashShiftId], references: [id])
  items         SaleItem[]
  payments      SalePayment[]

  // Conciliación de Transferencia Bancaria (RF-17)
  transferProofUrl        String?
  transferProofUploadedAt DateTime?
  reconciliationNotes     String?
  reconciledAt            DateTime?
  reconciledBy            String?

  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  @@index([status])
  @@index([channel, status, reservedUntil])
}

model SaleItem {
  id            String         @id @default(uuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  originalPrice Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?       @db.Decimal(12, 2)
  unitPrice     Decimal        @default(0) @db.Decimal(12, 2)
  price         Decimal        @db.Decimal(12, 2)
  subtotal      Decimal        @db.Decimal(12, 2)

  @@index([saleId])
  @@index([variantId])
}

model SalePayment {
  id                  String        @id @default(uuid())
  saleId              String
  sale                Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method              PaymentMethod
  amount              Decimal       @db.Decimal(12, 2)
  receivedAmount      Decimal?      @db.Decimal(12, 2)
  change              Decimal?      @db.Decimal(12, 2)
  cardBrand           String?
  cardVoucher         String?
  installments        Int?
  referenceCode       String?
  transferProofUrl    String?
  reconciliationNotes String?
}

// =========================================================================
// CLIENTES WEB REGISTRADOS Y LISTA DE FAVORITOS (RF-29)
// =========================================================================

model Customer {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String?    // Hash con bcryptjs (nullable para Google OAuth)
  googleId          String?    @unique
  avatarUrl         String?
  name              String
  phone             String?
  dni               String?
  defaultAddress    String?    // Calle y número
  defaultCity       String?    @default("Formosa")
  defaultPostalCode String?    @default("3600")
  favorites         Favorite[] // Productos guardados en lista de deseos
  sales             Sale[]     // Historial de compras vinculadas
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([email])
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

// =========================================================================
// SISTEMA DE PERFILES Y PERMISOS CON JERARQUÍA (OPCIÓN C - RF-23)
// =========================================================================

model Profile {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "Administrador", "Cajero Mostrador"
  description String?
  level       Int     @default(1) // Jerarquía: 100 (Admin), 50 (Encargado), 10 (Cajero)
  isSystem    Boolean @default(false)

  // Herencia jerárquica
  parentProfileId String?
  parentProfile   Profile?  @relation("ProfileHierarchy", fields: [parentProfileId], references: [id])
  childProfiles   Profile[] @relation("ProfileHierarchy")

  permissions ProfilePermission[]
  users       User[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Permission {
  id          String              @id @default(uuid())
  code        String              @unique // Ej: "pos.cobrar", "caja.arqueo", "inventario.precios"
  module      String // Ej: "POS", "CAJA", "INVENTARIO", "ECOMMERCE", "ADMIN"
  description String
  profiles    ProfilePermission[]
}

model ProfilePermission {
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
}

// =========================================================================
// GESTIÓN DE BANNERS Y CARRUSEL PROMOCIONAL EN LANDING (RF-26)
// =========================================================================

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  mobileUrl String?
  linkUrl   String?
  order     Int       @default(0)
  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([active, order])
  @@index([startDate, endDate])
}

model StoreSetting {
  id                 String   @id @default("default")
  storeName          String   @default("Matacos Deportes")
  whatsappNumber     String   @default("5493704000000")
  contactPhone       String   @default("+54 370 4429999")
  contactEmail       String   @default("ventas@matacosdeportes.com")
  notificationsEmail String?  @default("notificaciones@matacosdeportes.com")
  storeAddress       String   @default("Saavedra 241")
  storeCity          String   @default("Formosa Capital")
  storePostalCode    String   @default("3600")
  businessHours      String   @default("Lunes a Sábado de 08:30 a 12:30 y de 16:30 a 20:30 hs")
  instagramHandle    String   @default("@matacosdeportes")
  cadeteriaCost      Decimal  @default(2500) @db.Decimal(12, 2)
  updatedAt          DateTime @default(now()) @updatedAt
}
