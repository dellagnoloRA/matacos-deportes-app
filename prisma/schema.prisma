// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CAJERO
  DESPACHO
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
  QR_MERCADOPAGO
}

enum SaleStatus {
  PENDIENTE_PAGO
  COMPLETADA
  CANCELADA
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CashShiftStatus {
  ABIERTA
  CERRADA
}

enum CashMovementType {
  INGRESO_EXTRAORDINARIO
  RETIRO_CAJA_FUERTE
  GASTO_MENOR
  AJUSTE_ARQUEO
}

enum Gender {
  HOMBRE
  MUJER
  NINO
  UNISEX
}

model User {
  id             String      @id @default(uuid())
  username       String?     @unique
  email          String      @unique
  name           String
  password       String
  role           Role?       @default(CAJERO) // Campo legacy para compatibilidad
  profileId      String?
  profile        Profile?    @relation(fields: [profileId], references: [id])
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  sales          Sale[]
  salesAsSeller  Sale[]      @relation("SaleSeller")
  salesAsCashier Sale[]      @relation("SaleCashier")
  cashShifts     CashShift[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Discipline {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id           String           @id @default(uuid())
  name         String
  description  String?
  imageUrl     String?
  modelCode    String?
  disciplineId String
  discipline   Discipline       @relation(fields: [disciplineId], references: [id])
  costPrice    Decimal?         @db.Decimal(12, 2)
  price        Decimal          @db.Decimal(12, 2)
  active       Boolean          @default(true)
  ignoreAlerts Boolean          @default(false)
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  brandId      String
  brand        Brand            @relation(fields: [brandId], references: [id])
  gender       Gender           @default(UNISEX)
  variants     ProductVariant[]
  images       ProductImage[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  color     String? // Color asociado (ej: "Negro", "Marino/Rojo") o null para portada general
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           String // Talle: 41, M, L, Único, etc.
  color          String // Color: Negro, Azul, etc.
  sku            String              @unique
  barcode        String?             @unique
  stockStore     Int                 @default(0) // Stock en Salón de Ventas / Mostrador
  stockWarehouse Int                 @default(0) // Stock en Depósito interno
  stockReserved  Int                 @default(0) // Stock comprometido / reservado
  minStoreStock  Int                 @default(1) // Umbral alerta de reposición interna (Depósito -> Salón)
  minStock       Int                 @default(2) // Umbral alerta de compra a proveedor
  price          Decimal?            @db.Decimal(12, 2) // Precio específico si varía
  movements      InventoryMovement[]
  saleItems      SaleItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model InventoryMovement {
  id         String         @id @default(uuid())
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  type       String // INGRESO_INICIAL, INGRESO_COMPRA, VENTA_MOSTRADOR, VENTA_WEB, DEVOLUCION_CLIENTE, ANULACION_VENTA, AJUSTE_INGRESO, AJUSTE_EGRESO, TRANSFERENCIA_INTERNA
  quantity   Int
  stockAfter Int // Stock total resultante (stockStore + stockWarehouse)
  location   String? // "STORE", "WAREHOUSE", "WAREHOUSE_TO_STORE"
  reason     String?
  createdAt  DateTime       @default(now())
}

model CashShift {
  id               String          @id @default(uuid())
  terminalId       String // "TERMINAL_1_SALON" o "TERMINAL_2_CAJA"
  userId           String
  user             User            @relation(fields: [userId], references: [id])
  status           CashShiftStatus @default(ABIERTA)
  openedAt         DateTime        @default(now())
  closedAt         DateTime?
  initialAmount    Decimal         @db.Decimal(12, 2)
  expectedCash     Decimal?        @db.Decimal(12, 2)
  expectedDebit    Decimal?        @db.Decimal(12, 2)
  expectedCredit   Decimal?        @db.Decimal(12, 2)
  expectedTransfer Decimal?        @db.Decimal(12, 2)
  expectedQr       Decimal?        @db.Decimal(12, 2)
  actualCash       Decimal?        @db.Decimal(12, 2)
  actualDebit      Decimal?        @db.Decimal(12, 2)
  actualCredit     Decimal?        @db.Decimal(12, 2)
  actualTransfer   Decimal?        @db.Decimal(12, 2)
  actualQr         Decimal?        @db.Decimal(12, 2)
  differenceCash   Decimal?        @db.Decimal(12, 2)
  notes            String?
  sales            Sale[]
  movements        CashMovement[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CashMovement {
  id            String           @id @default(uuid())
  cashShiftId   String
  cashShift     CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  receiptNumber String?
  performedBy   String
  createdAt     DateTime         @default(now())
}

model Sale {
  id            String  @id @default(uuid())
  invoiceNumber String? @unique
  ticketCode    String?
  offlineId     String? @unique

  // Vínculo opcional con cuenta de cliente registrado
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Datos inmutables del comprador en este comprobante
  customerName  String?
  customerEmail String?
  customerPhone String?
  customerDni   String?

  // Datos logísticos de entrega en compras web
  shippingMethod     String? // "RETIRO_LOCAL", "CADETERIA_FORMOSA", "CORREO_ARGENTINO"
  shippingCost       Decimal? @default(0) @db.Decimal(12, 2)
  shippingAddress    String? // Calle y número
  shippingCity       String? // Localidad
  shippingPostalCode String?

  channel       String        @default("MOSTRADOR") // MOSTRADOR o WEB
  status        SaleStatus    @default(COMPLETADA)
  subtotalGross Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  notes         String?
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  sellerId      String?
  seller        User?         @relation("SaleSeller", fields: [sellerId], references: [id])
  cashierId     String?
  cashier       User?         @relation("SaleCashier", fields: [cashierId], references: [id])
  cashShiftId   String?
  cashShift     CashShift?    @relation(fields: [cashShiftId], references: [id])
  items         SaleItem[]
  payments      SalePayment[]
  syncedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model SaleItem {
  id            String         @id @default(uuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int
  originalPrice Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  discountType  DiscountType?
  discountValue Decimal?       @db.Decimal(12, 2)
  unitPrice     Decimal        @default(0) @db.Decimal(12, 2)
  price         Decimal        @db.Decimal(12, 2)
  subtotal      Decimal        @db.Decimal(12, 2)
}

model SalePayment {
  id             String        @id @default(uuid())
  saleId         String
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  receivedAmount Decimal?      @db.Decimal(12, 2)
  change         Decimal?      @db.Decimal(12, 2)
  cardBrand      String?
  cardVoucher    String?
  installments   Int?
  referenceCode  String?
}

// =========================================================================
// CLIENTES WEB REGISTRADOS (CUENTA OPCIONAL)
// =========================================================================

model Customer {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String // Hash con bcryptjs
  name              String
  phone             String?
  dni               String?
  defaultAddress    String? // Calle y número
  defaultCity       String?  @default("Formosa")
  defaultPostalCode String?  @default("3600")
  sales             Sale[] // Historial de compras vinculadas
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// =========================================================================
// SISTEMA DE PERFILES Y PERMISOS CON JERARQUÍA (OPCIÓN C - RF-23)
// =========================================================================

model Profile {
  id          String  @id @default(uuid())
  name        String  @unique // Ej: "Administrador", "Cajero Mostrador"
  description String?
  level       Int     @default(1) // Jerarquía: 100 (Admin), 50 (Encargado), 10 (Cajero)
  isSystem    Boolean @default(false)

  // Herencia jerárquica
  parentProfileId String?
  parentProfile   Profile?  @relation("ProfileHierarchy", fields: [parentProfileId], references: [id])
  childProfiles   Profile[] @relation("ProfileHierarchy")

  permissions ProfilePermission[]
  users       User[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Permission {
  id          String              @id @default(uuid())
  code        String              @unique // Ej: "pos.cobrar", "caja.arqueo", "inventario.precios"
  module      String // Ej: "POS", "CAJA", "INVENTARIO", "ECOMMERCE", "ADMIN"
  description String
  profiles    ProfilePermission[]
}

model ProfilePermission {
  profileId    String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionId])
}
